# Copy this file to .env.local for local development, and set the same
# values in Vercel's Project Settings -> Environment Variables when deploying.
#
# Find all three values in your Supabase project: Settings -> API.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SECRET — server-only. This key bypasses every database security rule, so
# it's what lets the admin create real logins for other players. It must
# NEVER start with NEXT_PUBLIC_ (that would ship it to every visitor's
# browser) and is only ever read inside app/api/**/route.js files, never in
# a "use client" component. In Supabase this is the "service_role" key
# (shown as "Secret key" on newer dashboards) on the same Settings -> API
# page — keep it out of git, screenshots, etc.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Mission-alert push notifications. Generate a pair once with:
#   npx web-push generate-vapid-keys
# The public key is safe in the browser (hence NEXT_PUBLIC_); the private
# key is SECRET — server-only, same rules as the service role key above.
# Leave both unset and the app still works, it just won't send phone alerts
# when a mission is sent — missions still show up on /profile either way.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
